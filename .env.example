# Public
NEXT_PUBLIC_SITE_URL=https://swisscottagessix.com

# Supabase (optional — enables browser/server clients when set)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# iCal (server-only — never expose to client)
AIRBNB_ICAL_URL=
BOOKING_ICAL_URL=

# Google Places — Place Details for reviews (optional; falls back to curated copy)
GOOGLE_PLACE_ID=
GOOGLE_PLACES_API_KEY=

# n8n lead webhook (server-only; at least one of n8n or Supabase required for /api/lead)
N8N_WEBHOOK_URL=

# Optional: embed Trustindex / Elfsight / other HTTPS review widget in Social proof section
NEXT_PUBLIC_OTA_REVIEWS_EMBED_URL=

# Vapi widget (NEXT_PUBLIC_* is required for browser widget)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# Claude AI chat widget — get your key at console.anthropic.com
ANTHROPIC_API_KEY=
